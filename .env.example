# Firebase / Firestore (catalog-data import tooling only — not used by Expo runtime)

# Required for --write (Admin SDK import script)
FIREBASE_PROJECT_ID=code2part-de0d
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# Optional: Firestore emulator (also pass --emulator to import CLI)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Expo app resolver mode (default: local)
# EXPO_PUBLIC_RESOLVER_MODE=local
# EXPO_PUBLIC_RESOLVER_MODE=backend
# EXPO_PUBLIC_RESOLVER_API_BASE_URL=https://europe-west3-code2part-de0d0.cloudfunctions.net
# EXPO_PUBLIC_RESOLVER_TIMEOUT_MS=30000
# EXPO_PUBLIC_RESOLVER_BACKEND_FALLBACK=false
